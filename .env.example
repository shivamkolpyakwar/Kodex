# =============================================================================
# Kodex — Self-Healing Codebase Agent
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ─── LLM Provider (OpenAI) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Qdrant Vector Database ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kodex_codebase

# ─── Docker Sandbox ─────────────────────────────────────────────────────────
SANDBOX_IMAGE=kodex-sandbox:latest
SANDBOX_TIMEOUT=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=50000

# ─── Agent Configuration ────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=60
MAX_RETRIES=3
DEFAULT_MODE=review

# ─── Session & Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
SESSION_DIR=./sessions
AUDIT_LOG_DIR=./audit_logs

# ─── Token Cost Configuration (USD per 1K tokens) ───────────────────────────
COST_PER_1K_PROMPT_TOKENS=0.0025
COST_PER_1K_COMPLETION_TOKENS=0.01
COST_PER_1K_EMBEDDING_TOKENS=0.00002
